# ==========================================
# AI Study Companion - Grade 6 Environment Config
# Copy this file to .env and fill in real values
# ==========================================

# PostgreSQL Database
POSTGRES_DB=study_companion
POSTGRES_USER=asc_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432

# Backend (Spring Boot 3.4 - Java 21)
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=change_me_to_a_secure_256bit_secret_key_for_jwt_signing
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# External AI & Search Secrets (Backend Only - NEVER expose to Frontend)
CKEY_API_BASE_URL=https://api.ckey.example/v1
CKEY_API_KEY=change_me_ckey_api_key
MIMO_MODEL_ID=mimo-v2-flash
BRAVE_API_KEY=change_me_brave_search_api_key
AI_MAX_SOURCES=3
AI_MAX_CONTEXT_TOKENS=2048

# Frontend (Next.js 14)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://backend:8080
NEXT_PUBLIC_DATA_MODE=mock
