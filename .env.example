# ==========================================
# Smart Otter - AI Study Companion Environment Config
# Copy this file to .env and fill in real values (NEVER commit .env)
# ==========================================

# PostgreSQL Database (Internal Docker network only - port is NOT published)
POSTGRES_DB=study_companion
POSTGRES_USER=asc_user
POSTGRES_PASSWORD=change_me_postgres_password

# Backend (Spring Boot 3.4 - Java 21, internal port 8080 on asc_network)
SPRING_PROFILES_ACTIVE=prod
HIBERNATE_FORMAT_SQL=false
JWT_SECRET=change_me_to_a_secure_256bit_secret_key_min_32_chars
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://domain.xyz
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Container-aware JVM flags (within 1536M container limit; no swap on VPS)
JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=70.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# External AI & Search Secrets (Backend Only - NEVER expose via NEXT_PUBLIC_*)
CKEY_API_BASE_URL=https://api.xah.io/v1
CKEY_API_KEY=change_me_ckey_api_key
MIMO_MODEL_ID=xztimee/laguna-xs-2.1
BRAVE_API_KEY=change_me_brave_search_api_key
AI_MAX_SOURCES=3
AI_MAX_CONTEXT_TOKENS=2048
# Ops-only AI usage telemetry secret (optional; leave blank to keep /api/ops/usage disabled)
OPS_ADMIN_SECRET=

# Frontend (Next.js 14 standalone bound ONLY to 127.0.0.1 for Nginx reverse proxy)
FRONTEND_HOST_PORT=3100
# Leave NEXT_PUBLIC_API_URL empty in production so browser calls same-origin /api/* via Next.js proxy
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://backend:8080
NEXT_PUBLIC_DATA_MODE=api
